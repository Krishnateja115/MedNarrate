{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedNarrate Admin",
  "version": "0.1.0",
  "identifier": "com.mednarrate.admin",
  "build": {
    "frontendDist": "../../mednarrate-admin/out",
    "beforeBuildCommand": "cd ../mednarrate-admin && TAURI_ENV=true NEXT_PUBLIC_API_BASE_URL=https://api.mednarrate.com npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MedNarrate Admin",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'unsafe-inline' http://localhost:*; connect-src 'self' http://localhost:* ws://localhost:* https://api.mednarrate.com; img-src 'self' data: https://*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}