DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mednarrate
SECRET_KEY=supersecretjwtkeythatshouldbechangedinproduction
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
ALLOWED_ORIGINS=["*"]
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_URL=http://localhost:11434

# Storage Configuration
STORAGE_BACKEND=local # Options: local, gcs, s3
STORAGE_BUCKET_NAME=your_gcs_bucket_name
GCS_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=us-east-1
