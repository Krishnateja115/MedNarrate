# ─────────────────────────────────────────────────────────────────────────────
# MedNarrate Backend — Environment Variables
# Copy this file to .env and fill in real values before starting the server.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL is the authoritative development and production database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mednarrate
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/mednarrate
AUTO_CREATE_SCHEMA=false
EXPECTED_SCHEMA_REVISION=110ba6a7df09

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. Must match the field name `JWT_SECRET` in app/core/config.py.
# (The old .env.example incorrectly used SECRET_KEY — that was wrong.)
JWT_SECRET=change-me-to-a-long-random-string

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Print every SQL statement (with data) in the terminal. Leave false unless you are debugging the database.
DB_ECHO=false
# Development default: FastAPI background task. Production requires "worker".
ANALYSIS_EXECUTION_MODE=background

# ── Token Lifetimes ───────────────────────────────────────────────────────────
# Access token TTL in minutes. Default: 15. Set higher (e.g. 60) for dev convenience.
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token TTL in days. Default: 7.
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Maximum allowed upload size in MB. Default: 25. Must match the Flutter UI hint.
# MAX_UPLOAD_MB=25

# ── CORS ──────────────────────────────────────────────────────────────────────
# SECURITY: "*" is only safe for local development.
# In production, replace with your exact frontend origin(s):
#   CORS_ORIGINS=["https://app.mednarrate.com"]
# CORS_ORIGINS=["*"]

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "auto"       → tries Vertex AI → Ollama → Dev Gemini in order
# "dev_gemini" → use GEMINI_API_KEY directly (recommended for local dev)
# "vertex_ai"  → Google Cloud Vertex AI (needs ADC / service account)
# "ollama"     → local Ollama instance
PRIMARY_LLM_PROVIDER=vertex_ai
LLM_PROVIDER=vertex_ai

# Development-only direct Gemini API key (get one at https://aistudio.google.com/apikey)
# Local development only; keep this unset in production.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# Fallback: when True (recommended), a missing/misconfigured LLM provider degrades
# to a deterministic templated summary instead of hard-failing the entire pipeline.
# Set to false only in environments where a templated fallback is unacceptable.
ENABLE_LLM_FALLBACK=true

# Vertex AI (production — only needed when PRIMARY_LLM_PROVIDER=vertex_ai)
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-3.8-flash

# Ollama (local — only needed when PRIMARY_LLM_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b

# ── Translation Providers ──────────────────────────────────────────────────────
# Production translation uses Vertex AI first, with direct Gemini as an optional fallback.
TRANSLATION_PROVIDER_ORDER=vertex_ai,gemini
# GEMINI_TRANSLATION_MODEL=gemini-3.8-flash
# OPENAI_TRANSLATION_MODEL=gpt-6.1-sol
# MISTRAL_TRANSLATION_MODEL=mistral-large-2512
# LOCAL_TRANSLATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" stores files in UPLOAD_DIR (default ./uploads). No cloud config needed.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# STORAGE_BUCKET_NAME=your-bucket
# GCS_PROJECT_ID=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# ── Firebase (optional — only needed for push notifications) ──────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project",...}
# Mobile medication reminders use local device alarms. Keep server push off in
# production until schedules store each user's timezone and deduplicate delivery.
SERVER_MEDICATION_PUSH_ENABLED=false

# ── SendGrid (optional — only needed for email features) ─────────────────────
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# ── Rate limiting (centralized, app/core/rate_limit.py) ──────────────────────
# Enabled by default. Per-client limits for login, MFA, signup, refresh and password reset.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=100/minute
# RATE_LIMIT_SENSITIVE=5/minute
# RATE_LIMIT_REFRESH=30/minute
# Counters are in-process memory by default. Multi-worker/multi-replica deployments MUST
# share counters, e.g. RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
# RATE_LIMIT_STORAGE_URI=

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Set TRUSTED_PROXY=true ONLY when running behind a proxy that strips/overwrites
# X-Forwarded-For. Otherwise the header is ignored (prevents IP spoofing of rate limits/audit logs).
# TRUSTED_PROXY=false

# ── RAG embeddings ────────────────────────────────────────────────────────────
# Provider for report-chunk embeddings (defaults to PRIMARY_LLM_PROVIDER). Report text is
# ALWAYS de-identified before it is sent, regardless of LLM_SEND_MODE.
# EMBEDDING_PROVIDER=gemini

# ── Production notes ──────────────────────────────────────────────────────────
# ENVIRONMENT=production disables /docs, /redoc and /openapi.json, disables the localhost CORS
# regex, and refuses to start with wildcard CORS, a weak JWT_SECRET, SQLite,
# or in-process report analysis. Start a separate analysis worker in production.

# ── Transactional e-mail (password-reset codes) ───────────────────────────────
# "log" only writes the message to the server log (development). In production use
# "sendgrid" or "smtp"; with "log" no reset e-mail is ever delivered.
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@mednarrate.app
EMAIL_FROM_NAME=MedNarrate
# SENDGRID_API_KEY=SG.xxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# ── Field encryption (MFA secrets, stored AI keys) ────────────────────────────
# Optional but recommended for production: generate once with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# so that rotating JWT_SECRET no longer makes stored MFA secrets unreadable. Keep old
# keys in ENCRYPTION_KEY_PREVIOUS (comma separated) while rotating.
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=

# --- Multi-provider AI (chat, summaries, translation) -----------------------
# Fill in as many keys as you have. Every provider with a working key is used
# in order, so one exhausted key no longer disables the app.
# NOTE: a direct GEMINI_API_KEY is only accepted when ENVIRONMENT=development.
# Check which providers work:  python -m app.llm_check
# LLM_PROVIDER_CHAIN=vertex_ai,gemini,openai,anthropic,mistral
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=

# --- Translation -------------------------------------------------------------
# Order in which providers are tried for report translation. Any other provider
# that has a key is appended automatically as a fallback.
# TRANSLATION_PROVIDER_ORDER=gemini,openai,mistral
# Whole-request budget in seconds (keep below the mobile app's 240 s timeout).
# TRANSLATION_DEADLINE_SECONDS=150
# Report sections translated in parallel (small on purpose: free tiers rate-limit).
# TRANSLATION_CONCURRENCY=3
# A direct GEMINI_API_KEY is refused when ENVIRONMENT=production (the Docker stack).
# PRIVACY: Google's free Gemini API tier may use prompts to improve its products, so
# do not send real patient data through a free key. For local testing / demos with
# synthetic reports you can opt in explicitly:
# ALLOW_GEMINI_API_KEY_IN_PRODUCTION=true
# Diagnose everything with:
#   docker compose exec backend python -m app.llm_check
#   docker compose exec backend python -m app.translation_check all

# Direct Gemini: other models on the same key, tried after the main one fails (separate free-tier quotas; a stronger model for Tamil, Telugu, etc.).
# GEMINI_FALLBACK_MODELS=<other-gemini-model>   (optional; only set a model your key can call)

# More free providers (all optional; each only needs its key). They are added to the
# translation chain after Gemini, OpenAI and Mistral, and to the chat chain.
# Free tiers change often - check each site. Prompts sent to free tiers may be logged
# or used for training by some providers: never send real patient data to them.
# Quality for Tamil/Telugu/Malayalam differs by model: run `python -m app.translation_check all`.
#   Groq        https://console.groq.com          GROQ_API_KEY=...        GROQ_MODEL=openai/gpt-oss-120b
#   Cerebras    https://cloud.cerebras.ai         CEREBRAS_API_KEY=...    CEREBRAS_MODEL=<a model your account lists>
#   OpenRouter  https://openrouter.ai             OPENROUTER_API_KEY=...  OPENROUTER_MODEL=<a ":free" model>
#   GitHub      https://github.com/marketplace/models   GITHUB_MODELS_TOKEN=<token with models access>  GITHUB_MODELS_MODEL=openai/gpt-4o-mini
# Choose the order with TRANSLATION_PROVIDER_ORDER, e.g. gemini,groq,openrouter

# Voice input: a microphone button in the chat box. The app records a short clip and
# the server turns it into text with Whisper on Groq (uses GROQ_API_KEY above, free tier).
# Off by default; with it off the microphone is simply not shown.
# PRIVACY: the recording is sent to Groq to be transcribed. It is not stored by MedNarrate
# and neither the audio nor the text is logged. Tell users in your privacy policy.
# VOICE_INPUT_ENABLED=true
# SPEECH_MODELS=whisper-large-v3,whisper-large-v3-turbo
# SPEECH_MAX_SECONDS=120
# SPEECH_MAX_BYTES=10485760
# SPEECH_RATE_LIMIT=20/minute
