# ─────────────────────────────────────────────────────────────────────────────
# MedNarrate Backend — Environment Variables
# Copy this file to .env and fill in real values before starting the server.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mednarrate
# Development (SQLite — no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:///./mednarrate.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. Must match the field name `JWT_SECRET` in app/core/config.py.
# (The old .env.example incorrectly used SECRET_KEY — that was wrong.)
JWT_SECRET=change-me-to-a-long-random-string

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Token Lifetimes ───────────────────────────────────────────────────────────
# Access token TTL in minutes. Default: 15. Set higher (e.g. 60) for dev convenience.
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token TTL in days. Default: 7.
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Maximum allowed upload size in MB. Default: 25. Must match the Flutter UI hint.
# MAX_UPLOAD_MB=25

# ── CORS ──────────────────────────────────────────────────────────────────────
# SECURITY: "*" is only safe for local development.
# In production, replace with your exact frontend origin(s):
#   CORS_ORIGINS=["https://app.mednarrate.com"]
# CORS_ORIGINS=["*"]

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "auto"       → tries Vertex AI → Ollama → Dev Gemini in order
# "dev_gemini" → use GEMINI_API_KEY directly (recommended for local dev)
# "vertex_ai"  → Google Cloud Vertex AI (needs ADC / service account)
# "ollama"     → local Ollama instance
PRIMARY_LLM_PROVIDER=dev_gemini
LLM_PROVIDER=dev_gemini

# Development-only direct Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Fallback: when True (recommended), a missing/misconfigured LLM provider degrades
# to a deterministic templated summary instead of hard-failing the entire pipeline.
# Set to false only in environments where a templated fallback is unacceptable.
ENABLE_LLM_FALLBACK=true

# Vertex AI (production — only needed when PRIMARY_LLM_PROVIDER=vertex_ai)
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-1.5-flash

# Ollama (local — only needed when PRIMARY_LLM_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:8b

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" stores files in UPLOAD_DIR (default ./uploads). No cloud config needed.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# STORAGE_BUCKET_NAME=your-bucket
# GCS_PROJECT_ID=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# ── Firebase (optional — only needed for push notifications) ──────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project",...}

# ── SendGrid (optional — only needed for email features) ─────────────────────
# SENDGRID_API_KEY=your_sendgrid_api_key_here
